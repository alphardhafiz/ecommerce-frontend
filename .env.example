# Di browser, API dipanggil same-origin (diproxy rewrites di next.config.ts).
# JANGAN set NEXT_PUBLIC_API_URL di sini — browser butuh origin sama agar cookie
# auth & CSRF bekerja (PRD §C.1).

# URL backend untuk jalur non-browser (scripts/smoke.ts), diatur di npm script.
# NEXT_PUBLIC_API_URL=http://localhost:8080

# Target proxy server-side (next.config.ts), default http://localhost:8080.
# API_PROXY_TARGET=http://localhost:8080
